# NAS Sentinel environment template (optional)
# If unset, values come from the Web Setup Wizard or data/config.json

NAS_HOST=192.168.1.100
NAS_USER=admin
NAS_PORT=22
SSH_KEY_PATH=~/.ssh/id_ed25519

# Bind address — keep 127.0.0.1 for personal/local use.
# Binding 0.0.0.0 without auth is unsupported; API_TOKEN is always required for /api/*.
MONITOR_HOST=127.0.0.1
MONITOR_PORT=8088
POLL_INTERVAL_SEC=15

# High-entropy API token for Authorization: Bearer <token> on all /api/* routes.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset, the server auto-generates one on first start and writes data/api_token.txt
API_TOKEN=

# Docker Compose only: path to a single dedicated private key file on the host
# (do not mount the entire ~/.ssh directory)
SSH_KEY_FILE=./secrets/nas_sentinel_ed25519

# Cloudflare edge log analysis (optional)
CF_API_TOKEN=
CF_ZONE_ID=
